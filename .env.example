# Để trống LLM_API_KEY thì hệ thống trả lời bằng chế độ trích dẫn khoản đã truy hồi.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash

# fastembed | sentence-transformers | hash
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Điểm RRF tối thiểu để nhận là có căn cứ trong kho (dùng cùng bộ lọc ngoài phạm vi).
ABSTAIN_RRF_THRESHOLD=0.012
